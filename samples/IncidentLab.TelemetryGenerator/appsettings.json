{
  "TelemetryGenerator": {
    "TargetBaseUrl": "http://localhost:5112/",
    "RequestsPerSecond": 1,
    "RequestTimeoutSeconds": 10,
    "MinimumOrderId": 1,
    "MaximumOrderId": 10,
    "AutomatedFailuresEnabled": true,
    "FailureScenarioIds": "slow-database,external-api-timeout,web-service-unavailable,ftp-transfer-failure,memory-leak",
    "FailureDurationSeconds": 45,
    "HealthyDurationSeconds": 90,
    "FailureDelayMilliseconds": null,
    "InitialHealthyDelaySeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
